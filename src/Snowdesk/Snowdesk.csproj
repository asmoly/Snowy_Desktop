<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <TargetFramework Condition="$(NETCoreSdkVersion.StartsWith('9.'))">net9.0-windows</TargetFramework>
    <RollForward>Major</RollForward>
    <UseWindowsForms>true</UseWindowsForms>
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>snowdesk</AssemblyName>
    <Version>0.1.0</Version>
    <Description>Falling snow with drifting wind for the Windows desktop.</Description>
  </PropertyGroup>
</Project>
